# Server-only Supabase credentials. Never prefix the service-role key with
# NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Public canonical URL for metadata, robots, and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 measurement ID. The browser-safe identifier has
# the form G-XXXXXXXXXX; omit it to keep analytics disabled.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional explicit OAuth callback URL. When omitted, the current request
# origin is used.
# AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
