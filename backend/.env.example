PORT=5000
# Comma-separated frontend origins allowed to make browser requests.
# Use your real HTTPS frontend domain(s) in production; do not include a trailing slash.
FRONTEND_ORIGINS=http://localhost:3000
# Canonical frontend URL. Used as a CORS fallback and for the Google callback.
FRONTEND_URL=http://localhost:3000
# Optional explicit Google/Supabase callback URL.
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
SUPABASE_URL=https://your-project.supabase.co
# Server-only service role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
